# ==============================================================================
# AI ORCHESTRATOR — CONFIGURATION TEMPLATE (.env.example)
# Sao chép file này thành .env và điền thông tin API Key của bạn
# ==============================================================================

# LLM Gateway Endpoint & Model chính
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_MODEL=deepseek-v4-flash-free
LLM_API_KEY=your_api_key_here

# Phân bổ Model theo vai trò chuyên biệt của từng Agent
MODEL_PLANNER=deepseek-v4-flash-free
MODEL_CODER=deepseek-v4-flash-free
MODEL_CRITIC=nemotron-3-ultra-free
MODEL_SUMMARY=mimo-v2.5-free

# Server Host & Port
HOST=127.0.0.1
PORT=8600
